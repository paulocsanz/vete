{
  "name": "tv",
  "version": "1.0.0",
  "description": "Private streaming catalog: Next.js frontend, Rust backend, torrent→S3 acquisition pipeline",
  "type": "module",
  "scripts": {
    "pipeline": "node scripts/pipeline/download-picked-torrents.js",
    "pipeline:pick": "node scripts/pipeline/pick-best-torrents.js",
    "pipeline:monitor": "node scripts/pipeline/monitor.js",
    "pipeline:hls": "node scripts/pipeline/package-hls-from-s3.js",
    "pipeline:reencrypt": "node scripts/pipeline/reencrypt-from-s3.js",
    "sala:relay": "node scripts/relay/sala-relay.js",
    "ops:deploy-pipeline": "./scripts/ops/deploy-pipeline-caixote.sh",
    "ops:monitor-caixote": "node scripts/ops/monitor-pipeline-caixote.mjs",
    "catalog:music": "node scripts/catalog/generate-music-catalog.mjs",
    "catalog:music:resume": "node scripts/catalog/generate-music-catalog.mjs --resume --target 200000",
    "catalog:music:dedupe": "node scripts/catalog/dedupe-music-catalog.mjs --in raw --out catalog --no-backup",
    "catalog:music:split": "node scripts/catalog/split-music-catalog.mjs --also-raw",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "streaming",
    "catalog",
    "hls",
    "pipeline"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/credential-providers": "^3.500.0",
    "@aws-sdk/lib-storage": "^3.1079.0",
    "@smithy/node-http-handler": "^4.9.0",
    "@types/node": "^20.19.43",
    "node-fetch": "^2.7.0",
    "parse-torrent": "^11.0.21",
    "railway": "^3.4.1",
    "torrent-search-api": "^2.1.4"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
